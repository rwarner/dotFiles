#Zsh RC — interactive shell config (prompt, aliases, functions)

# ── External Config ────────────────────────────────────────────────────────────

if [ -f ~/.zaliases ]; then
    source ~/.zaliases
fi

# ── Prompt ─────────────────────────────────────────────────────────────────────
setopt PROMPT_SUBST

# Current git branch — empty string if not in a repo
_git_branch() {
    git branch 2>/dev/null | grep '^\*' | sed 's/\* //'
}

# %(?.true.false) — zsh native exit status ternary, no PROMPT_COMMAND needed
PROMPT='[%F{blue}%n%f@%F{yellow}%m%f] %~ %F{green}$(_git_branch)%f %(?.%F{green}✓%f.%F{red}✗%f) $ '
