#!/bin/zsh
#############################
#### Zsh Aliases - MAIN  ####
#############################

# ── Additional Files ───────────────────────────────────────────────────────────

# Load work-specific aliases if applicable
if [ -f ~/.zaliases_work ]; then
    source ~/.zaliases_work
fi

# ── Docker ─────────────────────────────────────────────────────────────────────

alias dprune="docker system prune"
alias dremove="docker stop \$(docker ps -a -q) && docker rm \$(docker ps -a -q)"

# ── Git ────────────────────────────────────────────────────────────────────────
#
# Useful one-liners:
#   Remove local branches no longer on remote:
#     git fetch -p && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D
#
#   Catch a branch up without complicated rebasing:
#     git rebase --onto <newparent> <oldparent>
#
#   Rename a branch local and remote:
#     git checkout <old_name>
#     git branch -m <new_name>
#     git push -u origin :<old_name> <new_name>

alias gs="git status"
alias gpr="git pull --rebase --prune"

# ── Java ───────────────────────────────────────────────────────────────────────
# Switch Java version for the current session via mise.
# Versions downloaded on first use — browse with: mise ls-remote java | grep zulu
# Work machines: if _jv_post_hook is defined (e.g. in zaliases_work), it runs
# automatically after each switch (used for cert imports, etc).

jv() {
    if [ -z "$1" ]; then
        echo "Current: $(java -version 2>&1 | head -1)"
        echo "JAVA_HOME: ${JAVA_HOME:-not set}"
        echo ""
        echo "Usage:  jv zulu-21  |  jv zulu-17  |  jv zulu-11  |  jv zulu-8"
        echo "Browse: mise ls-remote java | grep zulu"
        return
    fi

    $HOME/.local/bin/mise use -g "java@${1}" || return 1
    eval "$($HOME/.local/bin/mise env --shell zsh)"
    echo "Switched to $(java -version 2>&1 | head -1)"
    echo "JAVA_HOME → $JAVA_HOME"

    # Work-specific post-switch hook (defined in zaliases_work if present)
    type _jv_post_hook &>/dev/null 2>&1 && _jv_post_hook
}

# ── Gradle ─────────────────────────────────────────────────────────────────────
# Switch Gradle version for the current session.
# Versions live in ~/Library/Gradle/ — run `gv` with no args to list them.

gv() {
    if [ -z "$1" ]; then
        echo "Available Gradle versions:"
        ls ~/Library/Gradle/ 2>/dev/null | sed 's/gradle-/  /'
        echo ""
        echo "Current: ${GRADLE_HOME:-not set}"
        return
    fi
    local gradle="$HOME/Library/Gradle/gradle-${1}"
    if [ -d "$gradle" ]; then
        export GRADLE_HOME="$gradle"
        export PATH="$GRADLE_HOME/bin:$(echo "$PATH" | tr ':' '\n' | grep -v 'Gradle' | tr '\n' ':' | sed 's/:$//')"
        echo "Switched to Gradle $1 ($GRADLE_HOME)"
    else
        echo "Not found: $gradle"
        echo "Available: $(ls ~/Library/Gradle/ 2>/dev/null | sed 's/gradle-//')"
    fi
}
