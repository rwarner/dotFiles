#!/bin/bash
#############################
#### Bash Aliases - MAIN ####
#############################

# ── Additional Files ───────────────────────────────────────────────────────────

# Load work-specific aliases if applicable
if [ -f ~/.bash_aliases_work ]; then
    source ~/.bash_aliases_work
fi

# ── Docker ─────────────────────────────────────────────────────────────────────

alias dprune="docker system prune"
alias dremove="docker stop \$(docker ps -a -q) && docker rm \$(docker ps -a -q)"

# ── Git ────────────────────────────────────────────────────────────────────────
#
# Useful one-liners:
#   Remove local branches no longer on remote:
#     git fetch -p && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D
#
#   Catch a branch up without complicated rebasing:
#     git rebase --onto <newparent> <oldparent>
#
#   Rename a branch local and remote:
#     git checkout <old_name>
#     git branch -m <new_name>
#     git push -u origin :<old_name> <new_name>

alias gs="git status"
alias gpr="git pull --rebase --prune"
