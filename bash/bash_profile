#Bash Profile

# Silence macOS prompt to switch to ZSH
export BASH_SILENCE_DEPRECATION_WARNING=1

# ── External Config ────────────────────────────────────────────────────────────

# Load MITRE specific proxy if applicable
if [ -f ~/.mitre_proxy ]; then
    source ~/.mitre_proxy
fi

# Load aliases if applicable
if [ -f ~/.bash_aliases ]; then
    source ~/.bash_aliases
fi

# Load work-specific profile if applicable
if [ -f ~/.bash_profile_work ]; then
    source ~/.bash_profile_work
fi

# ── SDK Homes ──────────────────────────────────────────────────────────────────

# Android SDK — build-tools resolves to latest installed version automatically
export ANDROID_HOME=~/Library/Android/sdk
export ANDROID_SDK=$ANDROID_HOME
export ANDROID_SDK_PLATFORM=$ANDROID_HOME/platform-tools
export ANDROID_SDK_BUILD=$ANDROID_HOME/build-tools/$(ls $ANDROID_HOME/build-tools/ 2>/dev/null | sort -V | tail -1)
export ANDROID_SDK_TOOLS=$ANDROID_HOME/tools

# Java
export JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-21.jdk/Contents/Home

# Go — resolves to latest installed version in ~/Library/Golang/
if [ -d ~/Library/Golang/ ]; then
    export GOROOT=~/Library/Golang/$(ls ~/Library/Golang/ | sort -V | tail -1)
    export GOPATH=$HOME/go
fi

# Gradle — resolves to latest installed version in ~/Library/Gradle/
if [ -d ~/Library/Gradle/ ]; then
    export GRADLE_HOME=~/Library/Gradle/$(ls ~/Library/Gradle/ | sort -V | tail -1)
fi

# Maven — resolves to latest installed version in ~/Library/Maven/ if present
if [ -d ~/Library/Maven/ ]; then
    export MAVEN_HOME=~/Library/Maven/$(ls ~/Library/Maven/ | sort -V | tail -1)
fi

# ── PATH ───────────────────────────────────────────────────────────────────────
# Built in priority order — first entry wins on conflicts.
# User-managed tools prepended so they take precedence over system defaults.
# ${VAR:+value} syntax safely omits an entry if the variable is unset or empty.

export PATH="\
$HOME/.local/bin:\
$HOME/.deno/bin:\
$HOME/.maestro/bin:\
${GOROOT:+$GOROOT/bin:}\
${GOPATH:+$GOPATH/bin:}\
${GRADLE_HOME:+$GRADLE_HOME/bin:}\
${MAVEN_HOME:+$MAVEN_HOME/bin:}\
$ANDROID_SDK_PLATFORM:\
$ANDROID_SDK_BUILD:\
$ANDROID_SDK_TOOLS:\
$JAVA_HOME/bin:\
$PATH"

# ── Version Managers ───────────────────────────────────────────────────────────
# mise replaces nvm, pyenv, and rbenv — one shim layer instead of three
# Versions configured in ~/.config/mise/config.toml
# Per-project overrides via .mise.toml or legacy .nvmrc / .python-version files

if [ -x "$HOME/.local/bin/mise" ]; then
    eval "$($HOME/.local/bin/mise activate bash)"
fi

# ── Prompt ─────────────────────────────────────────────────────────────────────

# Capture exit code before anything else in PS1 can overwrite $?
PROMPT_COMMAND='_ps1_exit=$?'

# Current git branch — empty string if not in a repo
_git_branch() {
    git branch 2>/dev/null | grep '^\*' | sed 's/\* //'
}

PS1="["
PS1+="\[\e[1;34m\]"                       # blue
PS1+="\u"                                 # current user
PS1+="\[\033[0m\]"                        # reset
PS1+="@"
PS1+="\[\e[0;33m\]"                       # yellow
PS1+="\h"                                 # host
PS1+="\[\033[0m\]"                        # reset
PS1+="] \w"                               # working directory
PS1+=" \[\e[0;32m\]\$(_git_branch)\[\033[0m\]"  # git branch in green
PS1+=' $( [ $_ps1_exit -eq 0 ] && echo "\[\e[0;32m\]✓" || echo "\[\e[0;31m\]✗")\[\033[0m\] $ '  # exit status
export PS1
